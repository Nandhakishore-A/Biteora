# Server
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/food_delivery

# Auth
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_SECRET_KEY=replace_with_admin_secret_key
ADMIN_PASSWORD=replace_with_secure_admin_password

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret

# Allowed origins (set to your deployed URLs in production)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Upload limits
MAX_UPLOAD_SIZE_BYTES=2097152

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
